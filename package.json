{
  "name": "sobredot",
  "version": "0.1.0",
  "private": true,
  "description": "Sobredot - uma solução da Oficina das Emoções. Visão integrada e longitudinal da criança.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --project demo-sobredot-tests --only firestore,storage \"vitest run --config vitest.rules.config.js\"",
    "test:functions": "npm --prefix functions run test",
    "lint": "eslint . --ext .js",
    "emulators": "firebase emulators:start --import=./.emulator-data --export-on-exit=./.emulator-data",
    "seed:emulator": "node scripts/seed-emulator.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "eslint": "^10.9.1",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.28.2",
    "jsdom": "^30.0.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "firebase": "^12.18.0"
  }
}
