# Sobredot — variáveis de ambiente de exemplo
# Copie este ficheiro para ".env" e preencha com valores do SEU projeto Firebase
# quando o backend for ligado (etapas seguintes). NUNCA coloque credenciais
# reais neste ficheiro de exemplo nem faça commit do ficheiro ".env".
#
# Nota: a "apiKey" de configuração web do Firebase não é, por si só, um
# segredo secreto (é visível no bundle do cliente), mas o acesso aos dados
# deve ser sempre protegido por Firebase App Check e por Regras de Segurança
# no Firestore/Storage — ver docs/threat-model.md.

# Apenas variáveis prefixadas com VITE_ ficam disponíveis no código do cliente.

VITE_FIREBASE_API_KEY=exemplo-api-key-000000
VITE_FIREBASE_AUTH_DOMAIN=sobredot-exemplo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sobredot-exemplo
VITE_FIREBASE_STORAGE_BUCKET=sobredot-exemplo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:exemplo0000000000
VITE_FIREBASE_MEASUREMENT_ID=G-EXEMPLO000

# Firebase App Check (reCAPTCHA v3)
VITE_FIREBASE_APPCHECK_SITE_KEY=exemplo-recaptcha-site-key

# Modo de depuração do App Check — SÓ para desenvolvimento local contra um
# projeto real (nunca contra produção, nunca com este valor "true" em
# builds publicados). Ver docs/firebase-setup.md, "App Check".
VITE_APPCHECK_DEBUG_MODE=false

# Liga o frontend ao Firebase Emulator Suite local em vez de um projeto
# real. Valor por omissão em desenvolvimento — ver docs/firebase-setup.md.
VITE_USE_EMULATORS=true

# Indica ao app que está a correr num ambiente com dados sintéticos
# (mostra o aviso "Dados de demonstração"). Continua a ser verdade mesmo
# com autenticação real ligada, enquanto os dados forem fictícios.
VITE_APP_DEMO_MODE=true
VITE_APP_NAME=Sobredot
